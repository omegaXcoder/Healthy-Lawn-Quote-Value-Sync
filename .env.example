# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# .env holds secrets + config. auth.setup.ts reads these to log in once and
# save the session to playwright/.auth/state.json. The sync test then reuses
# the saved session and never sees these credentials.

# The page the task scripts start from (used as baseURL). Trailing slash
# matters: relative goto('Customer/Search/Index') (no leading slash) resolves
# against this; a leading slash in goto() would drop the /809961/ segment.
BASE_URL=https://kiki.serviceassistant.com/809961/

# The login page.
LOGIN_URL=https://kiki.serviceassistant.com/809961/Login

# Credentials used ONLY by auth.setup.ts.
SAP_USER=
SAP_PASS=

# WhatConverts API credentials (agency-level, works across all client profiles).
WHATCONVERTS_API_TOKEN=
WHATCONVERTS_API_SECRET=

# Healthy Lawn NJ's WhatConverts profile (account_id 102720 / profile_id 152222).
WHATCONVERTS_PROFILE_ID=152222

# SMTP settings used to email the run log ("AUTOMATION LOGGING" subject).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=omega@kudos.marketing

# Optional: override the auto-calculated "previous two full Sun-Sat weeks"
# date range for a backfill or reprocessing. Format YYYY-MM-DD, both or neither.
#   START_DATE=2026-06-01 END_DATE=2026-06-14 npm run sync:dry
# START_DATE=
# END_DATE=
